{
  "name": "darling", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "server": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "desktop": "electron apps/desktop",
    "desktop:device-test": "node scripts/start-device-diagnostic.mjs",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "native:aec3-evaluate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -EvaluateAec3",
    "native:aec3-smoke": "tsx scripts/smoke-duplex.ts --aec3",
    "native:smoke": "tsx scripts/smoke-native.ts",
    "native:capture-smoke": "tsx scripts/smoke-capture.ts",
    "native:duplex-smoke": "tsx scripts/smoke-duplex.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": { "fastify": "^5.6.0", "@fastify/websocket": "^11.2.0", "ws": "^8.18.3", "zod": "^4.1.0", "react": "^19.1.0", "react-dom": "^19.1.0", "mammoth": "^1.13.0", "unpdf": "^1.9.1" },
  "devDependencies": { "typescript": "^5.9.0", "tsx": "^4.20.0", "esbuild": "^0.25.0", "vite": "^7.1.0", "electron": "^41.0.0", "@types/node": "^24.0.0", "@types/ws": "^8.18.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "jszip": "^3.10.2" }
}
