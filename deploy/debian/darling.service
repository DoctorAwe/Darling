[Unit]
Description=Darling chat service
After=network.target

[Service]
Type=simple
User=darling
WorkingDirectory=/opt/darling
Environment=DARLING_SERVER_CONFIG=/etc/darling/server.config.json
ExecStart=/usr/bin/node /opt/darling/apps/server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
